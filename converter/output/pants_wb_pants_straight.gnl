-- pants_wb_pants_straight — converted from the Korosteleva NeurIPS 2021 dataset
-- Generated by converter/convert.js. Regenerate rather than hand-editing.
--
-- Measured from the source pattern: panel outlines (poly, in cm), edge
--   curvature, panel placement, opening circumferences, and the stitch list.
-- Inferred by the converter: body regions, edge names, and which unstitched
--   edges form which opening. Run converter/evaluate.js for how far those
--   inferences hold up against the dataset's own stitching.
-- Not in the source, so not here: fabric, grain, seam types (every seam is
--   emitted as plain), and construction order — BUILD lists the stitches in
--   dataset order, which is not a sewing sequence.
-- Bilateral pairs are present but both sides are declared explicitly, so
--   the garment is not marked [SYM].

GARMENT pants_wb_pants_straight {

  -- Panels
  Lback = P(%leg.L, poly[
    (20, 0) : waist,
    (0, 0) : outseam,
    (0, -60) : hem,
    (30, -60) ~ (0.95, 0.1) : inseam,
    (30, -30) ~ (0.25, 0.4) : crotch
  ], 1.0)
  Rback = P(%leg.R, poly[
    (-30, -30) ~ (0.05, 0.1) : inseam,
    (-30, -60) : hem,
    (0, -60) : outseam,
    (0, 0) : waist,
    (-20, 0) ~ (0.75, 0.4) : crotch
  ], 1.0)
  Rfront = P(%leg.R, poly[
    (20, 0) : waist,
    (0, 0) : outseam,
    (0, -60) : hem,
    (30, -60) ~ (0.95, 0.1) : inseam,
    (30, -30) ~ (0.25, 0.35) : crotch
  ], 1.0)
  Lfront = P(%leg.L, poly[
    (-30, -30) ~ (0.05, 0.1) : inseam,
    (-30, -60) : hem,
    (0, -60) : outseam,
    (0, 0) : waist,
    (-20, 0) ~ (0.75, 0.35) : crotch
  ], 1.0)
  wb_back = P(%torso.front, poly[
    (-13, -2) : hem_l,
    (0, -2) : hem_r,
    (13, -2) : armhole_r,
    (13, 2) : neckline,
    (-13, 2) : armhole_l
  ], 1.0)
  wb_front = P(%torso.front, poly[
    (-13, -2) : hem_r,
    (0, -2) : hem_l,
    (13, -2) : armhole_l,
    (13, 2) : neckline,
    (-13, 2) : armhole_r
  ], 1.0)

  -- Openings (circumference measured from the unstitched edges)
  leg_hem_l = O(@ankle, circle, 60cm)
  leg_hem_r = O(@ankle, circle, 60cm)
  neck = O(@neck, circle, 52cm)

  -- Stitches, in dataset order
  BUILD:
    S(Rfront.outseam, Rback.outseam, plain)
    >> S(Rfront.inseam, Rback.inseam, plain)
    >> S(Lfront.outseam, Lback.outseam, plain)
    >> S(Lfront.inseam, Lback.inseam, plain)
    >> S(Rback.crotch, Lback.crotch, plain)
    >> S(Rfront.crotch, Lfront.crotch, plain)
    >> S(Rfront.waist, wb_front.hem_r, plain)
    >> S(Lfront.waist, wb_front.hem_l, plain)
    >> S(Lback.waist, wb_back.hem_l, plain)
    >> S(Rback.waist, wb_back.hem_r, plain)
    >> S(wb_back.armhole_r, wb_front.armhole_r, plain)
    >> S(wb_back.armhole_l, wb_front.armhole_l, plain)
}
