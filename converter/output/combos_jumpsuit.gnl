-- combos_jumpsuit — converted from the Korosteleva NeurIPS 2021 dataset
-- Generated by converter/convert.js. Regenerate rather than hand-editing.
--
-- Measured from the source pattern: panel outlines (poly, in cm), edge
--   curvature, panel placement, opening circumferences, and the stitch list.
-- Inferred by the converter: body regions, edge names, and which unstitched
--   edges form which opening. Run converter/evaluate.js for how far those
--   inferences hold up against the dataset's own stitching.
-- Not in the source, so not here: fabric, grain, seam types (every seam is
--   emitted as plain), and construction order — BUILD lists the stitches in
--   dataset order, which is not a sewing sequence.
-- Bilateral pairs are present but both sides are declared explicitly, so
--   the garment is not marked [SYM].

GARMENT combos_jumpsuit {

  -- Panels
  up_back = P(%torso.back, poly[
    (-21.667, -17.083) : hem_l,
    (0, -17.083) : hem_r,
    (21.667, -17.083) : side_r,
    (21.667, 2.917) ~ (0.3, 0.4) : armhole_r,
    (18.333, 19.583) : shoulder_r,
    (8.333, 19.583) ~ (0.5, 0.3) : neckline,
    (-8.333, 19.583) : shoulder_l,
    (-18.333, 19.583) ~ (0.7, 0.4) : armhole_l,
    (-21.667, 2.917) : side_l
  ], 1.0)
  up_front = P(%torso.front, poly[
    (-21.667, -17.963) : hem_r,
    (0, -17.963) : hem_l,
    (21.667, -17.963) : side_l,
    (21.667, 2.037) ~ (0.3, 0.4) : armhole_l,
    (18.333, 18.704) : shoulder_l,
    (8.333, 18.704) : neckline_l,
    (0, 7.037) : neckline_r,
    (-8.333, 18.704) : shoulder_r,
    (-18.333, 18.704) ~ (0.7, 0.4) : armhole_r,
    (-21.667, 2.037) : side_r
  ], 1.0)
  rbsleeve = P(%arm.R, poly[
    (-3.333, -8.333) : under,
    (8.333, -8.333) ~ (0.7, -0.4) : cap,
    (5, 8.333) : upper,
    (-3.333, 8.333) : cuff
  ], 1.0)
  rfsleeve = P(%arm.R, poly[
    (-3.333, -8.333) : upper,
    (5, -8.333) ~ (0.3, -0.4) : cap,
    (8.333, 8.333) : under,
    (-3.333, 8.333) : cuff
  ], 1.0)
  lfsleeve = P(%arm.L, poly[
    (-3.333, -8.333) : upper,
    (8.333, -8.333) ~ (0.7, -0.4) : cap,
    (5, 8.333) : under,
    (-3.333, 8.333) : cuff
  ], 1.0)
  lbsleeve = P(%arm.L, poly[
    (-3.333, -8.333) : under,
    (5, -8.333) ~ (0.3, -0.4) : cap,
    (8.333, 8.333) : upper,
    (-3.333, 8.333) : cuff
  ], 1.0)
  Lback = P(%leg.L, poly[
    (21.67, 0) : waist,
    (0, 0) ~ (0.15, -0.05) : outseam,
    (0, -60) : hem,
    (31.67, -60) ~ (0.95, 0.1) : inseam,
    (31.67, -31.5) ~ (0.25, 0.4) : crotch
  ], 1.0)
  Rback = P(%leg.R, poly[
    (-31.67, -31.5) ~ (0.05, 0.1) : inseam,
    (-31.67, -60) : hem,
    (0, -60) ~ (0.85, -0.05) : outseam,
    (0, 0) : waist,
    (-21.67, 0) ~ (0.75, 0.4) : crotch
  ], 1.0)
  Rfront = P(%leg.R, poly[
    (21.67, 0) : waist,
    (0, 0) ~ (0.15, -0.05) : outseam,
    (0, -60) : hem,
    (31.67, -60) ~ (0.95, 0.1) : inseam,
    (31.67, -31.5) ~ (0.25, 0.35) : crotch
  ], 1.0)
  Lfront = P(%leg.L, poly[
    (-31.67, -31.5) ~ (0.05, 0.1) : inseam,
    (-31.67, -60) : hem,
    (0, -60) ~ (0.85, -0.05) : outseam,
    (0, 0) : waist,
    (-21.67, 0) ~ (0.75, 0.35) : crotch
  ], 1.0)

  -- Openings (circumference measured from the unstitched edges)
  neck = O(@neck, circle, 45.3cm)
  cuff_r = O(@wrist, circle, 33.3cm)
  cuff_l = O(@wrist, circle, 33.3cm)
  leg_hem_l = O(@ankle, circle, 63.3cm)
  leg_hem_r = O(@ankle, circle, 63.3cm)

  -- Stitches, in dataset order
  BUILD:
    S(up_back.shoulder_r, up_front.shoulder_r, plain)
    >> S(up_back.side_r, up_front.side_r, plain)
    >> S(up_back.side_l, up_front.side_l, plain)
    >> S(up_back.shoulder_l, up_front.shoulder_l, plain)
    >> S(Rfront.outseam, Rback.outseam, plain)
    >> S(Rfront.inseam, Rback.inseam, plain)
    >> S(Lfront.outseam, Lback.outseam, plain)
    >> S(Lfront.inseam, Lback.inseam, plain)
    >> S(Rback.crotch, Lback.crotch, plain)
    >> S(Rfront.crotch, Lfront.crotch, plain)
    >> S(Rfront.waist, up_front.hem_r, plain)
    >> S(Lfront.waist, up_front.hem_l, plain)
    >> S(Lback.waist, up_back.hem_l, plain)
    >> S(Rback.waist, up_back.hem_r, plain)
    >> S(rfsleeve.cap, up_front.armhole_r, plain)
    >> S(rbsleeve.cap, up_back.armhole_r, plain)
    >> S(lfsleeve.cap, up_front.armhole_l, plain)
    >> S(lbsleeve.cap, up_back.armhole_l, plain)
    >> S(lbsleeve.under, lfsleeve.under, plain)
    >> S(lbsleeve.upper, lfsleeve.upper, plain)
    >> S(rbsleeve.upper, rfsleeve.upper, plain)
    >> S(rbsleeve.under, rfsleeve.under, plain)
}
