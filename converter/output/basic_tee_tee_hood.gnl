-- basic_tee_tee_hood — converted from the Korosteleva NeurIPS 2021 dataset
-- Generated by converter/convert.js. Regenerate rather than hand-editing.
--
-- Measured from the source pattern: panel outlines (poly, in cm), edge
--   curvature, panel placement, opening circumferences, and the stitch list.
-- Inferred by the converter: body regions, edge names, and which unstitched
--   edges form which opening. Run converter/evaluate.js for how far those
--   inferences hold up against the dataset's own stitching.
-- Not in the source, so not here: fabric, grain, seam types (every seam is
--   emitted as plain), and construction order — BUILD lists the stitches in
--   dataset order, which is not a sewing sequence.
-- Bilateral pairs are present but both sides are declared explicitly, so
--   the garment is not marked [SYM].

GARMENT basic_tee_tee_hood {

  -- Panels
  lfsleeve = P(%arm.L, poly[
    (-3.333, 8.333) : cuff,
    (-3.333, -8.333) : upper,
    (8.333, -8.333) ~ (0.7, -0.4) : cap,
    (5, 8.333) : under
  ], 1.0)
  back = P(%torso.back, poly[
    (0, 16.917) : neckline_l,
    (8.333, 19.583) : shoulder_l,
    (18.333, 19.583) ~ (0.7, -0.4) : armhole_l,
    (21.667, 2.917) : side_l,
    (21.667, -42.083) : hem,
    (-21.667, -42.083) : side_r,
    (-21.667, 2.917) ~ (0.3, -0.4) : armhole_r,
    (-18.333, 19.583) : shoulder_r,
    (-8.333, 19.583) : neckline_r
  ], 1.0)
  lbsleeve = P(%arm.L, poly[
    (-3.333, 8.333) : cuff,
    (-3.333, -8.333) : under,
    (5, -8.333) ~ (0.3, -0.4) : cap,
    (8.333, 8.333) : upper
  ], 1.0)
  rfsleeve = P(%arm.R, poly[
    (-3.333, 8.333) : cuff,
    (-3.333, -8.333) : upper,
    (5, -8.333) ~ (0.3, -0.4) : cap,
    (8.333, 8.333) : under
  ], 1.0)
  rbsleeve = P(%arm.R, poly[
    (-3.333, 8.333) : cuff,
    (-3.333, -8.333) : under,
    (8.333, -8.333) ~ (0.7, -0.4) : cap,
    (5, 8.333) : upper
  ], 1.0)
  front = P(%torso.front, poly[
    (0, 7.037) : neckline_r,
    (-8.333, 18.704) : shoulder_r,
    (-18.333, 18.704) ~ (0.7, 0.4) : armhole_r,
    (-21.667, 2.037) : side_r,
    (-21.667, -42.963) : hem,
    (21.667, -42.963) : side_l,
    (21.667, 2.037) ~ (0.3, 0.4) : armhole_l,
    (18.333, 18.704) : shoulder_l,
    (8.333, 18.704) : neckline_l
  ], 1.0)
  Lhood = P(%torso.front, poly[
    (-23.333, 16.667) : armhole_r,
    (-20, -25) : edge1,
    (-11.667, -13.333) : edge2,
    (-3.333, -16) ~ (0.7, -0.6) : edge3,
    (-13.333, 16.667) : shoulder_r
  ], 1.0)
  Rhood = P(%torso.front, poly[
    (-20, 25) : armhole_r,
    (-23.333, -16.667) : shoulder_r,
    (-13.333, -16.667) ~ (0.3, -0.6) : edge2,
    (-3.333, 16) : edge3,
    (-11.667, 13.333) : edge4
  ], 1.0)

  -- Openings (circumference measured from the unstitched edges)
  cuff_l = O(@wrist, circle, 33.3cm)
  hem = O(@hip, circle, 86.7cm)
  cuff_r = O(@wrist, circle, 33.3cm)

  -- Stitches, in dataset order
  BUILD:
    S(back.shoulder_r, front.shoulder_r, plain)
    >> S(back.side_r, front.side_r, plain)
    >> S(back.side_l, front.side_l, plain)
    >> S(back.shoulder_l, front.shoulder_l, plain)
    >> S(rfsleeve.cap, front.armhole_r, plain)
    >> S(rbsleeve.cap, back.armhole_r, plain)
    >> S(lfsleeve.cap, front.armhole_l, plain)
    >> S(lbsleeve.cap, back.armhole_l, plain)
    >> S(lbsleeve.under, lfsleeve.under, plain)
    >> S(lbsleeve.upper, lfsleeve.upper, plain)
    >> S(rbsleeve.upper, rfsleeve.upper, plain)
    >> S(rbsleeve.under, rfsleeve.under, plain)
    >> S(Rhood.shoulder_r, Lhood.shoulder_r, plain)
    >> S(Rhood.edge2, Lhood.edge3, plain)
    >> S(Rhood.edge4, front.neckline_r, plain)
    >> S(Lhood.edge1, front.neckline_l, plain)
    >> S(Rhood.edge3, back.neckline_r, plain)
    >> S(Lhood.edge2, back.neckline_l, plain)
}
