-- combos_dress — converted from the Korosteleva NeurIPS 2021 dataset
-- Generated by converter/convert.js. Regenerate rather than hand-editing.
--
-- Measured from the source pattern: panel outlines (poly, in cm), edge
--   curvature, panel placement, opening circumferences, and the stitch list.
-- Inferred by the converter: body regions, edge names, and which unstitched
--   edges form which opening. Run converter/evaluate.js for how far those
--   inferences hold up against the dataset's own stitching.
-- Not in the source, so not here: fabric, grain, seam types (every seam is
--   emitted as plain), and construction order — BUILD lists the stitches in
--   dataset order, which is not a sewing sequence.
-- Bilateral pairs are present but both sides are declared explicitly, so
--   the garment is not marked [SYM].

GARMENT combos_dress {

  -- Panels
  top_back = P(%torso.back, poly[
    (-17, -17.083) : hem,
    (17, -17.083) : side_r,
    (21.667, 2.917) ~ (0.3, 0.4) : armhole_r,
    (18.333, 19.583) : shoulder_r,
    (8.333, 19.583) ~ (0.5, 0.3) : neckline,
    (-8.333, 19.583) : shoulder_l,
    (-18.333, 19.583) ~ (0.7, 0.4) : armhole_l,
    (-21.667, 2.917) : side_l
  ], 1.0)
  top_front = P(%torso.front, poly[
    (-17, -17.963) : hem,
    (17, -17.963) : side_l,
    (21.667, 2.037) ~ (0.3, 0.4) : armhole_l,
    (18.333, 18.704) : shoulder_l,
    (8.333, 18.704) : neckline_l,
    (0, 7.037) : neckline_r,
    (-8.333, 18.704) : shoulder_r,
    (-18.333, 18.704) ~ (0.7, 0.4) : armhole_r,
    (-21.667, 2.037) : side_r
  ], 1.0)
  skirt_front = P(%torso.front + %leg[0..0.3], poly[
    (-33.333, -30) ~ (0.5, -0.1) : hem,
    (33.333, -30) : side_l_lower,
    (22.583, 10) : side_l_upper,
    (17, 25) : waist,
    (-17, 25) : side_r_upper,
    (-22.583, 10) : side_r_lower
  ], 1.0)
  skirt_back = P(%torso.back + %leg[0..0.3], poly[
    (-33.333, -30) ~ (0.5, -0.1) : hem,
    (33.333, -30) : side_r_lower,
    (22.583, 10) : side_r_upper,
    (17, 25) : waist,
    (-17, 25) : side_l_upper,
    (-22.583, 10) : side_l_lower
  ], 1.0)
  lfsleeve = P(%arm.L, poly[
    (-3.333, -8.333) : upper,
    (8.333, -8.333) ~ (0.7, -0.4) : cap,
    (5, 8.333) : under,
    (-3.333, 8.333) : cuff
  ], 1.0)
  lbsleeve = P(%arm.L, poly[
    (-3.333, -8.333) : under,
    (5, -8.333) ~ (0.3, -0.4) : cap,
    (8.333, 8.333) : upper,
    (-3.333, 8.333) : cuff
  ], 1.0)
  rbsleeve = P(%arm.R, poly[
    (-3.333, -8.333) : under,
    (8.333, -8.333) ~ (0.7, -0.4) : cap,
    (5, 8.333) : upper,
    (-3.333, 8.333) : cuff
  ], 1.0)
  rfsleeve = P(%arm.R, poly[
    (-3.333, -8.333) : upper,
    (5, -8.333) ~ (0.3, -0.4) : cap,
    (8.333, 8.333) : under,
    (-3.333, 8.333) : cuff
  ], 1.0)

  -- Openings (circumference measured from the unstitched edges)
  neck = O(@neck, circle, 45.3cm)
  hem = O(@knee, circle, 133.3cm)
  cuff_l = O(@wrist, circle, 33.3cm)
  cuff_r = O(@wrist, circle, 33.3cm)

  -- Stitches, in dataset order
  BUILD:
    S(top_back.side_l, top_front.side_l, plain)
    >> S(top_back.shoulder_l, top_front.shoulder_l, plain)
    >> S(top_back.shoulder_r, top_front.shoulder_r, plain)
    >> S(top_back.side_r, top_front.side_r, plain)
    >> S(skirt_back.side_r_upper, skirt_front.side_r_upper, plain)
    >> S(skirt_back.side_r_lower, skirt_front.side_r_lower, plain)
    >> S(skirt_back.side_l_lower, skirt_front.side_l_lower, plain)
    >> S(skirt_back.side_l_upper, skirt_front.side_l_upper, plain)
    >> S(skirt_front.waist, top_front.hem, plain)
    >> S(top_back.hem, skirt_back.waist, plain)
    >> S(rfsleeve.cap, top_front.armhole_r, plain)
    >> S(rbsleeve.cap, top_back.armhole_r, plain)
    >> S(lfsleeve.cap, top_front.armhole_l, plain)
    >> S(lbsleeve.cap, top_back.armhole_l, plain)
    >> S(lbsleeve.under, lfsleeve.under, plain)
    >> S(lbsleeve.upper, lfsleeve.upper, plain)
    >> S(rbsleeve.upper, rfsleeve.upper, plain)
    >> S(rbsleeve.under, rfsleeve.under, plain)
}
