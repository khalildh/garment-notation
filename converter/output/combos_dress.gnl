GARMENT combos_dress [SYM] {

  -- Panels
  top_back = P(%torso.back, contour, 0.98)
  top_front = P(%torso.front, contour, 0.94)
  skirt_front = P(%torso.front + %leg[0..0.3], contour, 1.45)
  skirt_back = P(%torso.back + %leg[0..0.3], contour, 1.52)
  lfsleeve = P(%arm.L, contour, 1.1)
  lbsleeve = P(%arm.L, contour, 1.1)
  rbsleeve = P(%arm.R, contour, 1.1)
  rfsleeve = P(%arm.R, contour, 1.1)

  -- Build order
  BUILD:
    S(top_back.side_l, top_front.side_r, plain)
    >>     S(top_back.hem2, top_front.hem, plain)
    >>     S(top_back.hem, top_front.hem2, plain)
    >>     S(top_back.side_r, top_front.side_l, plain)
    >>     S(skirt_back.outseam2, skirt_front.inseam, plain)
    >>     S(skirt_back.outseam, skirt_front.inseam2, plain)
    >>     S(skirt_back.inseam2, skirt_front.outseam, plain)
    >>     S(skirt_back.inseam, skirt_front.outseam2, plain)
    >>     S(skirt_front.hem, top_front.shoulder_r, plain)
    >>     S(top_back.shoulder_r, skirt_back.hem, plain)
    >>     S(rfsleeve.cap, top_front.armhole_l, plain)
    >>     S(rbsleeve.cap, top_back.armhole_r, plain)
    >>     S(lfsleeve.cap, top_front.armhole_r, plain)
    >>     S(lbsleeve.cap, top_back.armhole_l, plain)
    >>     S(lbsleeve.top, lfsleeve.cuff, plain)
    >>     S(lbsleeve.cuff, lfsleeve.top, plain)
    >>     S(rbsleeve.cuff, rfsleeve.top, plain)
    >>     S(rbsleeve.top, rfsleeve.cuff, plain)
}
