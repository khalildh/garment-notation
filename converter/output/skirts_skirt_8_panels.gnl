-- skirts_skirt_8_panels — converted from the Korosteleva NeurIPS 2021 dataset
-- Generated by converter/convert.js. Regenerate rather than hand-editing.
--
-- Measured from the source pattern: panel outlines (poly, in cm), edge
--   curvature, panel placement, opening circumferences, and the stitch list.
-- Inferred by the converter: body regions, edge names, and which unstitched
--   edges form which opening. Run converter/evaluate.js for how far those
--   inferences hold up against the dataset's own stitching.
-- Not in the source, so not here: fabric, grain, seam types (every seam is
--   emitted as plain), and construction order — BUILD lists the stitches in
--   dataset order, which is not a sewing sequence.

GARMENT skirts_skirt_8_panels {

  -- Panels
  back = P(%torso.back + %leg[0..0.3], poly[
    (-13.333, -30) ~ (0.5, -0.1) : hem,
    (13.333, -30) : side_r_lower,
    (7.083, 15) : side_r_upper,
    (5, 30) ~ (0.5, 0.1) : waist,
    (-5, 30) : side_l_upper,
    (-7.083, 15) : side_l_lower
  ], 1.0)
  right_0 = P(%torso.R + %leg.R[0..0.3], poly[
    (-13.333, -30) ~ (0.5, -0.1) : hem,
    (13.333, -30) : side_r_lower,
    (7.083, 15) : side_r_upper,
    (5, 30) ~ (0.5, 0.1) : waist,
    (-5, 30) : side_l_upper,
    (-7.083, 15) : side_l_lower
  ], 1.0)
  right_1 = P(%torso.R + %leg.R[0..0.3], poly[
    (-13.333, -30) ~ (0.5, -0.1) : hem,
    (13.333, -30) : side_l_lower,
    (7.083, 15) : side_l_upper,
    (5, 30) ~ (0.5, 0.1) : waist,
    (-5, 30) : side_r_upper,
    (-7.083, 15) : side_r_lower
  ], 1.0)
  right_2 = P(%torso.R + %leg.R[0..0.3], poly[
    (-13.333, -30) ~ (0.5, -0.1) : hem,
    (13.333, -30) : side_l_lower,
    (7.083, 15) : side_l_upper,
    (5, 30) ~ (0.5, 0.1) : waist,
    (-5, 30) : side_r_upper,
    (-7.083, 15) : side_r_lower
  ], 1.0)
  left_0 = P(%torso.L + %leg.L[0..0.3], poly[
    (-13.333, -30) ~ (0.5, -0.1) : hem,
    (13.333, -30) : side_r_lower,
    (7.083, 15) : side_r_upper,
    (5, 30) ~ (0.5, 0.1) : waist,
    (-5, 30) : side_l_upper,
    (-7.083, 15) : side_l_lower
  ], 1.0)
  left_1 = P(%torso.L + %leg.L[0..0.3], poly[
    (-13.333, -30) ~ (0.5, -0.1) : hem,
    (13.333, -30) : side_l_lower,
    (7.083, 15) : side_l_upper,
    (5, 30) ~ (0.5, 0.1) : waist,
    (-5, 30) : side_r_upper,
    (-7.083, 15) : side_r_lower
  ], 1.0)
  left_2 = P(%torso.L + %leg.L[0..0.3], poly[
    (-13.333, -30) ~ (0.5, -0.1) : hem,
    (13.333, -30) : side_l_lower,
    (7.083, 15) : side_l_upper,
    (5, 30) ~ (0.5, 0.1) : waist,
    (-5, 30) : side_r_upper,
    (-7.083, 15) : side_r_lower
  ], 1.0)
  front = P(%torso.front + %leg[0..0.3], poly[
    (-13.333, -30) ~ (0.5, -0.1) : hem,
    (13.333, -30) : side_l_lower,
    (7.083, 15) : side_l_upper,
    (5, 30) ~ (0.5, 0.1) : waist,
    (-5, 30) : side_r_upper,
    (-7.083, 15) : side_r_lower
  ], 1.0)

  -- Openings (circumference measured from the unstitched edges)
  hem = O(@knee, circle, 213.3cm)
  waist = O(@waist, circle, 80cm)

  -- Stitches, in dataset order
  BUILD:
    S(back.side_r_lower, right_0.side_l_lower, plain)
    >> S(back.side_r_upper, right_0.side_l_upper, plain)
    >> S(right_0.side_r_lower, right_1.side_r_lower, plain)
    >> S(right_0.side_r_upper, right_1.side_r_upper, plain)
    >> S(right_1.side_l_lower, right_2.side_r_lower, plain)
    >> S(right_1.side_l_upper, right_2.side_r_upper, plain)
    >> S(right_2.side_l_lower, front.side_r_lower, plain)
    >> S(right_2.side_l_upper, front.side_r_upper, plain)
    >> S(front.side_l_lower, left_2.side_r_lower, plain)
    >> S(front.side_l_upper, left_2.side_r_upper, plain)
    >> S(left_2.side_l_lower, left_1.side_r_lower, plain)
    >> S(left_2.side_l_upper, left_1.side_r_upper, plain)
    >> S(left_1.side_l_lower, left_0.side_l_lower, plain)
    >> S(left_1.side_l_upper, left_0.side_l_upper, plain)
    >> S(left_0.side_r_lower, back.side_l_lower, plain)
    >> S(left_0.side_r_upper, back.side_l_upper, plain)
}
