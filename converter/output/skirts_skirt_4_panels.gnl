GARMENT skirts_skirt_4_panels {

  -- Panels
  front = P(%torso.front, contour, 1.23)
  right = P(%torso.R, contour, 1.1)
  back = P(%torso.back, contour, 1.29)
  left = P(%torso.L, contour, 1.1)

  -- Openings
  hem = O(@knee, circle, body+10cm)

  -- Build order
  BUILD:
    S(right.right2, front.side_l, plain)
    >>     S(right.right, front.side_l2, plain)
    >>     S(left.left2, front.side_r, plain)
    >>     S(left.left, front.side_r2, plain)
    >>     S(left.right2, back.side_r, plain)
    >>     S(left.right, back.side_r2, plain)
    >>     S(right.left, back.side_l2, plain)
    >>     S(right.left2, back.side_l, plain)
}
