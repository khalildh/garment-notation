-- skirts_skirt_4_panels — converted from the Korosteleva NeurIPS 2021 dataset
-- Generated by converter/convert.js. Regenerate rather than hand-editing.
--
-- Measured from the source pattern: panel outlines (poly, in cm), edge
--   curvature, panel placement, opening circumferences, and the stitch list.
-- Inferred by the converter: body regions, edge names, and which unstitched
--   edges form which opening. Run converter/evaluate.js for how far those
--   inferences hold up against the dataset's own stitching.
-- Not in the source, so not here: fabric, grain, seam types (every seam is
--   emitted as plain), and construction order — BUILD lists the stitches in
--   dataset order, which is not a sewing sequence.

GARMENT skirts_skirt_4_panels {

  -- Panels
  front = P(%torso.front + %leg[0..0.3], poly[
    (14, 30) ~ (0.5, 0.1) : waist,
    (-14, 30) : side_r_upper,
    (-17.583, 15) : side_r_lower,
    (-28.333, -30) ~ (0.5, -0.1) : hem,
    (28.333, -30) : side_l_lower,
    (17.583, 15) : side_l_upper
  ], 1.0)
  right = P(%torso.R + %leg.R[0..0.3], poly[
    (5, 30) ~ (0.5, 0.1) : waist,
    (-5, 30) : side_r_upper,
    (-7.083, 15) : side_r_lower,
    (-13.333, -30) ~ (0.5, -0.1) : hem,
    (13.333, -30) : side_l_lower,
    (7.083, 15) : side_l_upper
  ], 1.0)
  back = P(%torso.back + %leg[0..0.3], poly[
    (-14, 30) ~ (0.5, -0.1) : waist,
    (14, 30) : side_l_upper,
    (17.583, 15) : side_l_lower,
    (28.333, -30) ~ (0.5, 0.1) : hem,
    (-28.333, -30) : side_r_lower,
    (-17.583, 15) : side_r_upper
  ], 1.0)
  left = P(%torso.L + %leg.L[0..0.3], poly[
    (5, 30) ~ (0.5, 0.1) : waist,
    (-5, 30) : side_r_upper,
    (-7.083, 15) : side_r_lower,
    (-13.333, -30) ~ (0.5, -0.1) : hem,
    (13.333, -30) : side_l_lower,
    (7.083, 15) : side_l_upper
  ], 1.0)

  -- Openings (circumference measured from the unstitched edges)
  waist = O(@waist, circle, 76cm)
  hem = O(@knee, circle, 166.7cm)

  -- Stitches, in dataset order
  BUILD:
    S(right.side_l_upper, front.side_r_upper, plain)
    >> S(right.side_l_lower, front.side_r_lower, plain)
    >> S(left.side_r_lower, front.side_l_lower, plain)
    >> S(left.side_r_upper, front.side_l_upper, plain)
    >> S(left.side_l_upper, back.side_l_upper, plain)
    >> S(left.side_l_lower, back.side_l_lower, plain)
    >> S(right.side_r_upper, back.side_r_upper, plain)
    >> S(right.side_r_lower, back.side_r_lower, plain)
}
