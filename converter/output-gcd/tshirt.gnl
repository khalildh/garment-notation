-- tshirt — converted from GarmentCodeData (ECCV 2024)
-- Generated by converter/convert-gcd.js. Regenerate rather than hand-editing.
--
-- Measured from the source pattern: panel outlines (poly, in cm), edge
--   curvature, panel placement, opening circumferences, and the stitch list.
-- Inferred by the converter: body regions, edge names, and which unstitched
--   edges form which opening. Run converter/evaluate.js for how far those
--   inferences hold up against the dataset's own stitching.
-- Not in the source, so not here: fabric, grain, seam types (every seam is
--   emitted as plain), and construction order — BUILD lists the stitches in
--   dataset order, which is not a sewing sequence.
-- Bilateral pairs are present but both sides are declared explicitly, so
--   the garment is not marked [SYM].

GARMENT tshirt {

  -- Panels
  right_btorso = P(%torso.back, poly[
    (0, 0) : hem,
    (-25.03, 0) : side_r,
    (-25.03, 28.929) ~ (0.2, -0.35; 0.5, -0.2) : armhole_r,
    (-17.228, 47.371) : shoulder_r,
    (-10.819, 49.918) ~ arc(13.185, 0, 1) : neckline_r,
    (0, 44.27) : center_back
  ], 1.0)
  right_sleeve_b = P(%arm.R, poly[
    (0, 0) : under,
    (22.04, 0) ~ (0.329, 0.004; 0.663, 0.004) : cap_l,
    (22.045, -0.625) ~ (0.431, 0.17; 0.662, -0.012) : cap_lower,
    (13.684, -21.051) : upper,
    (0, -21.051) : cuff
  ], 1.0)
  right_sleeve_f = P(%arm.R, poly[
    (0, 0) : cuff,
    (0, -21.051) : upper,
    (13.684, -21.051) ~ (0.333, 0.014; 0.596, -0.151) : cap,
    (22.04, 0) : under
  ], 1.0)
  right_ftorso = P(%torso.front, poly[
    (0, 0) : center_front,
    (0, 34.315) ~ arc(11.564, 0, 0) : neckline_r,
    (-10.819, 49.963) : shoulder_r,
    (-17.228, 47.415) ~ (0.336, 0; 0.669, 0) : armhole_r_upper,
    (-17.305, 46.79) ~ (0.495, 0.206; 0.794, 0.351) : armhole_r,
    (-27.386, 28.974) : side_r,
    (-27.386, 0) : hem
  ], 1.0)
  left_btorso = P(%torso.back, poly[
    (0, 0) : center_back,
    (0, 44.27) ~ arc(13.185, 0, 1) : neckline_l,
    (10.819, 49.918) : shoulder_l,
    (17.228, 47.371) ~ (0.5, -0.2; 0.8, -0.35) : armhole_l,
    (25.03, 28.929) : side_l,
    (25.03, 0) : hem
  ], 1.0)
  left_sleeve_b = P(%arm.L, poly[
    (0, 0) : cuff,
    (0, -21.051) : under,
    (-13.684, -21.051) ~ (0.338, -0.012; 0.569, 0.17) : cap_r,
    (-22.045, -0.625) ~ (0.337, 0.004; 0.671, 0.004) : cap_upper,
    (-22.04, 0) : upper
  ], 1.0)
  left_sleeve_f = P(%arm.L, poly[
    (0, 0) : upper,
    (-22.04, 0) ~ (0.404, -0.151; 0.667, 0.014) : cap,
    (-13.684, -21.051) : under,
    (0, -21.051) : cuff
  ], 1.0)
  left_ftorso = P(%torso.front, poly[
    (0, 0) : hem,
    (27.386, 0) : side_l,
    (27.386, 28.974) ~ (0.206, 0.351; 0.505, 0.206) : armhole_l_upper,
    (17.305, 46.79) ~ (0.331, 0; 0.664, 0) : armhole_l,
    (17.228, 47.415) : shoulder_l,
    (10.819, 49.963) ~ arc(11.564, 0, 0) : neckline_l,
    (0, 34.315) : center_front
  ], 1.0)

  -- Openings (circumference measured from the unstitched edges)
  hem = O(@hip, circle, 104.8cm)
  neck = O(@neck, circle, 62.5cm)
  cuff_l = O(@wrist, circle, 42.1cm)
  cuff_r = O(@wrist, circle, 42.1cm)

  -- Stitches, in dataset order
  BUILD:
    S(left_sleeve_f.upper, left_sleeve_b.upper, plain)
    >> S(left_sleeve_f.under, left_sleeve_b.under, plain)
    >> S(left_sleeve_f.cap, left_ftorso.armhole_l_upper, plain)
    >> S(left_sleeve_b.cap_upper, left_ftorso.armhole_l, plain)
    >> S(left_sleeve_b.cap_r, left_btorso.armhole_l, plain)
    >> S(left_ftorso.shoulder_l, left_btorso.shoulder_l, plain)
    >> S(left_ftorso.side_l, left_btorso.side_l, plain)
    >> S(right_sleeve_f.under, right_sleeve_b.under, plain)
    >> S(right_sleeve_f.upper, right_sleeve_b.upper, plain)
    >> S(right_sleeve_f.cap, right_ftorso.armhole_r, plain)
    >> S(right_sleeve_b.cap_l, right_ftorso.armhole_r_upper, plain)
    >> S(right_sleeve_b.cap_lower, right_btorso.armhole_r, plain)
    >> S(right_ftorso.shoulder_r, right_btorso.shoulder_r, plain)
    >> S(right_ftorso.side_r, right_btorso.side_r, plain)
    >> S(right_ftorso.center_front, left_ftorso.center_front, plain)
    >> S(right_btorso.center_back, left_btorso.center_back, plain)
}
